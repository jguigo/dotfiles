# ~/.config/kanshi/config

profile docked_home {
    output "AOC 27G2G8 PWPP5XA000354" mode 1920x1080@60 position 0,0 scale 1
    output eDP-1 disable
}

profile docked_generic {
    output HDMI-A-1 position 0,0 scale 1
    output eDP-1 disable
}

profile mobile {
    output eDP-1 enable mode 1920x1080@60 position 0,0 scale 1.25
}
